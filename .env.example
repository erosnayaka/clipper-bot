# Contoh konfigurasi. Copy ke .env atau export langsung.
# Token bot JANGAN taruh di sini — simpan di file .bot_token (sudah di-gitignore).

# Wajib: Telegram user ID yang boleh pakai bot (koma-pemisah). Lihat ID via @userinfobot
ALLOWED_TELEGRAM_IDS="123456789"

# Opsional: override path tool (default: python yg jalan + file di folder repo)
# CLIPPER_VENV_PY="/path/ke/venv/bin/python"
# CLIPPER_YT_CLIP="/path/ke/yt-clip.py"
# CLIPPER_GDRIVE_SPLIT="/path/ke/gdrive-split.py"
# TT_INTERVAL_STATE="/path/ke/tiktok_interval.json"
